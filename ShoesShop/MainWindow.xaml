<Window x:Class="ShoesShop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Shoes Shop"
        Height="600"
        Width="900"
        WindowStartupLocation="CenterScreen"
        Background="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#E6E6E6" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BackButton"
                        Content="← Назад"
                        Click="BackButton_Click"
                        Visibility="Collapsed"/>

                <StackPanel Grid.Column="2"
                            x:Name="UserInfoPanel"
                            Orientation="Horizontal"
                            Visibility="Collapsed">
                    <TextBlock Text="Роль: "/>
                    <TextBlock x:Name="RoleTextBlock" FontWeight="Bold" Margin="0,0,10,0"/>
                    <TextBlock Text="Пользователь: "/>
                    <TextBlock x:Name="UsernameTextBlock" FontWeight="Bold" Margin="0,0,10,0"/>
                    <Button Content="Выйти" Click="LogoutButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- NAV -->
        <StackPanel Grid.Row="1" Orientation="Horizontal">
            <Button x:Name="ProductsButton" Content="Products" Click="ProductsButton_Click"/>
            <Button x:Name="EditProductButton" Content="Edit Product" Click="EditProductButton_Click"/>
            <Button x:Name="OrdersButton" Content="Orders" Click="OrdersButton_Click"/>
            <Button x:Name="EditOrderButton" Content="Edit Order" Click="EditOrderButton_Click"/>
            <Button x:Name="SelectProductsButton" Content="Select Products" Click="SelectProductsButton_Click"/>
        </StackPanel>

        <!-- CONTENT -->
        <Frame x:Name="MainFrame"
               Grid.Row="2"
               NavigationUIVisibility="Hidden"
               Navigated="MainFrame_Navigated"/>
    </Grid>
</Window>
